    doc.addPage();doc.addImage(cv2.toDataURL('image/jpeg',.92),'JPEG',0,0,210,297);
   }
   root.innerHTML='';
  const blob=doc.output('blob'),name='attendance-'+D.date+(gfilt!=='all'?'-'+gfilt:'')+'.pdf';
  const dl=window.claude&&claude.use?await claude.use('downloads'):null;
  if(dl){await dl.save({filename:name,data:blob})}
  else{const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click()}
 }catch(e){
  if(!(e&&e.code==='declined'))$('msg').textContent='สร้าง PDF ไม่สำเร็จ: '+(e&&e.message||e);
 }
 b.disabled=false;b.textContent=old;
}
$('pdf').onclick=exportPdf;

/* ---------- ไม่พบการสแกน (จากรายชื่อที่จำไว้) ---------- */
function absList(){
 const r=R[sk(D.site)]||{},here=new Set(D.rows.map(p=>p.id));
 return Object.keys(r).filter(id=>!here.has(id)&&(gfilt==='all'||(G[id]||'none')===gfilt)).map(id=>({id,name:r[id].n,last:r[id].l})).sort((a,b)=>String(a.name).localeCompare(String(b.name)));
}
function absRender(){
 const el=$('abs');if(!D){return}
 const has=Object.keys(R[sk(D.site)]||{}).length>0;el.hidden=!has;if(!has)return;
 const a=absList();
 $('abss').textContent='ไม่พบการสแกนวันนี้ '+a.length+' คน (จากรายชื่อที่แอพจำไว้)';
 $('absl').innerHTML=a.length?a.map(x=>`<div class="ar"><span><b>${esc(x.name)}</b> <small>รหัส ${esc(x.id)} · ${G[x.id]?esc(tl(G[x.id])):'ยังไม่ระบุกลุ่ม'}${W[x.id]?' · ค่าแรง '+fmt(W[x.id].w):''} · เห็นล่าสุด ${esc(x.last)}</small></span><button class="btn" data-rm="${esc(x.id)}">เอาออกจากรายชื่อ</button></div>`).join(''):'<p class="key" style="margin:8px 0 0">ทุกคนในรายชื่อที่จำไว้มีการสแกนแล้ว</p>';
}
$('abs').addEventListener('click',e=>{
 const b=e.target.closest('[data-rm]');if(!b)return;
 if(b.dataset.arm!=='1'){b.dataset.arm='1';b.textContent='ยืนยันลบ';setTimeout(()=>{if(b.isConnected){b.dataset.arm='';b.textContent='เอาออกจากรายชื่อ'}},4000);return}
 const k=sk(D.site);if(R[k])delete R[k][b.dataset.rm];saveG();render();
});
function absPage(list,start,pages){
 const gl=gfilt==='all'?'ทุกกลุ่ม':gfilt==='none'?'ยังไม่ระบุกลุ่ม':GN[gfilt];
 return `<div class="pg"><h3>ไม่พบการสแกนวันนี้</h3><div>${esc(D.site)} · วันที่ ${esc(thDate(D.date))}</div>
 <div class="c" style="margin:6px 0 12px">รายชื่อที่แอพจำไว้ แต่ไม่มีรายการสแกนในไฟล์ของวันนี้ (${esc(gl)})</div>
 <table><thead><tr><th>ลำดับ</th><th>รหัส</th><th>ชื่อ</th><th>กลุ่ม</th><th>เห็นล่าสุด</th></tr></thead><tbody>${list.map((a,i)=>`<tr><td>${start+i+1}</td><td>${esc(a.id)}</td><td>${esc(a.name)}</td><td>${G[a.id]?esc(tl(G[a.id])):'-'}</td><td>${esc(a.last)}</td></tr>`).join('')}</tbody></table>
 <div class="ft"><span></span><span>หน้า ${pages[0]}/${pages[1]}</span></div></div>`;
}

function findSite(lines){return (lines.find(l=>/[A-Za-z]{3,}.*\(.*\)/.test(l)&&!/\.php|index|attendance/i.test(l))||'').replace(/\s+/g,' ').trim()}

/* ---------- ค่าแรง ---------- */
$('list').addEventListener('change',e=>{
 const id=e.target.dataset&&e.target.dataset.w;if(!id)return;
 const v=e.target.value.trim();
 if(v===''){delete W[id]}else{const n=+v;if(!isFinite(n)||n<0){e.target.value=W[id]?W[id].w:'';return}W[id]={w:n,at:D?D.date:''}}
 saveG();gchips();
});
const CATS=[['ก่อสร้าง',/ก่อส/],['ไฟฟ้า',/ไฟ/],['ประปา',/ประปา|สุขา/],['ส่วนกลาง',/ส่วนกลาง/]];
function parseWage(lines){
 let cat='',site='',from='',to='';const rows=[];
 lines.forEach(l=>{
  const nl=l.replace(/(\d)\s*-\s*(\d)/g,'$1-$2');
  const s=l.match(/หน่วยงาน[^:]*:\s*(.+)/);if(s&&!site)site=s[1].trim();
  const ds=nl.match(/\d{2}-\d{2}-\d{4}/g);if(ds&&ds.length>=2&&!to){from=ds[0];to=ds[1]}
  const t=l.replace(/\s+/g,'');
  if(/^ช่าง/.test(t)&&!/\d/.test(t)){const m=CATS.filter(c=>c[1].test(t));if(m.length===1)cat=m[0][0]}
  const r=l.match(/^(\d{1,3})\s+(\d{6,8})\s+(.+?)\s+([\d,]+\.\d{2})\s+([\d,]+\.\d{2})\s*$/);
  if(r&&cat)rows.push({id:r[2],name:r[3].replace(/^(นางสาว|นาย|นาง)\s*/,'').trim(),cat,w:parseFloat(r[4].replace(/,/g,''))});
 });
 const seen=new Set();
 return{site:site||findSite(lines),from,to,rows:rows.filter(r=>!seen.has(r.id)&&seen.add(r.id))};
}
let WP=null;
async function handleWage(file){
 const m=$('wmsg');m.textContent='';m.style.color='';$('wprev').hidden=true;
 if(!file)return;
 try{
  m.style.color='var(--mut)';m.textContent='กำลังอ่านไฟล์ค่าแรง…';
  const p=parseWage(await readLines(file));m.style.color='';
  if(!p.rows.length){m.textContent='อ่านรายการค่าแรงไม่พบ ตรวจว่าเป็น PDF จากหน้า “ประมาณการค่าแรง” ของ TMC HR (ไม่ใช่หน้าข้อมูลการลงเวลา)';return}
  m.textContent='';WP=p;wpReview();
 }catch(e){m.style.color='';m.textContent=(e&&e.message==='NOTEXT')?'PDF ค่าแรงนี้ไม่มีตัวอักษรให้อ่าน ให้พิมพ์ใหม่ด้วย Chrome (Ctrl+P แล้วเลือกปลายทาง “บันทึกเป็น PDF”)':'เปิดไฟล์ไม่สำเร็จ: '+(e&&e.message||e)}
}
function wpReview(){
 const rows=WP.rows,nw=rows.filter(r=>!W[r.id]),sm=rows.filter(r=>W[r.id]&&W[r.id].w===r.w),ch=rows.filter(r=>W[r.id]&&W[r.id].w!==r.w);
 const per=WP.to?' (ข้อมูลวันที่ '+esc(WP.from===WP.to?WP.to:WP.from+' ถึง '+WP.to)+')':'';
 $('wprev').innerHTML=`<b>พบ ${rows.length} คน${per}</b>
 <div class="key" style="margin:4px 0">คนใหม่ ${nw.length} · ค่าแรงตรงกับที่จำไว้ ${sm.length} · ค่าแรงต่างจากที่จำไว้ ${ch.length}</div>
 ${ch.length?`<table><thead><tr><th>ชื่อ</th><th>รหัส</th><th>ที่จำไว้</th><th>ในไฟล์นี้</th></tr></thead><tbody>${ch.map(r=>`<tr><td>${esc(r.name)}</td><td>${esc(r.id)}</td><td>${fmt(W[r.id].w)}</td><td>${fmt(r.w)}</td></tr>`).join('')}</tbody></table><div class="key">ถ้าเป็นรอบปรับค่าแรง ให้เลือก “เพิ่มคนใหม่ และอัปเดตค่าที่เปลี่ยน” แต่ถ้าวันนั้นมีคนทำงานไม่ครบวัน ค่าในไฟล์อาจต่ำกว่าอัตราปกติ ให้เลือกเพิ่มเฉพาะคนใหม่</div>`:''}
 <label class="wg" style="display:flex"><input type="checkbox" id="wtyp" checked style="width:auto"> ตั้งประเภทคนงานตามหัวข้อในไฟล์ (ก่อสร้าง = ST/AR, ไฟฟ้า, ประปา = สุขาภิบาล, ส่วนกลาง) เฉพาะคนที่ยังไม่ระบุประเภท</label>
 <div class="ro"><button class="btn pri" id="wok1">เพิ่มเฉพาะคนใหม่${nw.length?' ('+nw.length+')':''}</button>${ch.length?`<button class="btn" id="wok2">เพิ่มคนใหม่ และอัปเดตค่าที่เปลี่ยน (${ch.length})</button>`:''}<button class="btn" id="wno">ยกเลิก</button></div>`;
 $('wprev').hidden=false;
}
function catKey(cat){
 const dk={'ก่อสร้าง':'st','ไฟฟ้า':'el','ประปา':'sn'}[cat];
 if(dk)return TY.some(t=>t.k===dk)?dk:null;
 let t=TY.find(x=>x.l==='ส่วนกลาง');
 if(!t){const used=TY.map(x=>x.i),i=[...PAL.keys()].find(n=>!used.includes(n));t={k:'t'+Date.now().toString(36),l:'ส่วนกลาง',i:i===undefined?TY.length:i};TY.push(t);syncT();tmRender()}
 return t.k;
}
function wapply(upd){
 let a=0,u=0,t=0;const key=sk(WP.site),at=WP.to||'';
 const typ=$('wtyp')&&$('wtyp').checked;
 WP.rows.forEach(r=>{
  const o=W[r.id];
  if(!o){W[r.id]={w:r.w,at};a++}else if(upd&&o.w!==r.w){W[r.id]={w:r.w,at};u++}
  if(key){R[key]=R[key]||{};if(!R[key][r.id])R[key][r.id]={n:r.name,l:at||'-'}}
  if(typ&&!G[r.id]){const k=catKey(r.cat);if(k){G[r.id]=k;t++}}
 });
 saveG();$('wprev').hidden=true;
 const m=$('wmsg');m.style.color='var(--ok)';
 m.textContent='บันทึกแล้ว: เพิ่มค่าแรงคนใหม่ '+a+' คน'+(u?' · อัปเดต '+u+' คน':'')+(t?' · ตั้งประเภทให้ '+t+' คน':'');
 WP=null;if(D){chips();render()}
}
$('wfile').addEventListener('change',e=>{const f=e.target.files[0];handleWage(f);e.target.value=''});
$('wprev').addEventListener('click',e=>{
 const b=e.target.closest('button');if(!b)return;
 if(b.id==='wok1')wapply(false);else if(b.id==='wok2')wapply(true);else if(b.id==='wno'){$('wprev').hidden=true;WP=null}
});
</script>
