<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ตรวจสอบรายสแกนหน้า</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#ECEEEA;--sf:#fff;--ink:#1B211D;--mut:#667068;--ln:#D5D9D3;--ac:#F5B800;--ok:#1F7A4D;--okb:#DDF1E4;--wn:#9A6700;--wnb:#FBEBC3;--ms:#B3261E;--msb:#F9DAD7;--md:#2F55A4;--mdb:#DBE5F8;--tl:#E4E7E2;--zn:#CBE8D4;--xx:#8A938C;color-scheme:light}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141814;--sf:#1D231F;--ink:#E8ECE7;--mut:#98A39B;--ln:#333B35;--ok:#6FD39A;--okb:#1D3A2A;--wn:#F2C14E;--wnb:#3F3213;--ms:#F28B82;--msb:#432120;--md:#8FB0F2;--mdb:#1F2C4A;--tl:#2A312C;--zn:#24402F;--xx:#7B857E;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#141814;--sf:#1D231F;--ink:#E8ECE7;--mut:#98A39B;--ln:#333B35;--ok:#6FD39A;--okb:#1D3A2A;--wn:#F2C14E;--wnb:#3F3213;--ms:#F28B82;--msb:#432120;--md:#8FB0F2;--mdb:#1F2C4A;--tl:#2A312C;--zn:#24402F;--xx:#7B857E;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.55 "IBM Plex Sans Thai",system-ui,sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:20px 16px 56px}
header{border-top:5px solid var(--ac);padding-top:14px;margin-bottom:18px}
h1{font-size:1.55rem;margin:0 0 4px;font-weight:700;letter-spacing:-.01em}
header p{margin:0;color:var(--mut);max-width:60ch}
button,select,input{font:inherit;color:inherit}
.drop{display:block;border:2px dashed var(--ln);border-radius:12px;background:var(--sf);padding:28px 18px;text-align:center;cursor:pointer}
.drop:hover,.drop.on,.drop:focus-within{border-color:var(--ac);background:var(--tl)}
.drop b{font-size:1.05rem}.drop span{display:block;color:var(--mut);font-size:.9rem;margin-top:2px}
.drop input{position:absolute;opacity:0;width:1px;height:1px}
.rules{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin:14px 0 0;padding:0;list-style:none}
.rules li{background:var(--sf);border:1px solid var(--ln);border-radius:8px;padding:10px 12px;font-size:.9rem}
.rules strong{display:block;font-size:.95rem}
.rules em{font-style:normal;color:var(--mut)}
#msg{margin:12px 0 0;color:var(--ms);font-weight:500}
#res{display:none;margin-top:22px}
.meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 16px;align-items:flex-end;margin-bottom:14px}
.meta h2{margin:0;font-size:1.2rem}.meta p{margin:2px 0 0;color:var(--mut)}
.btn{border:1px solid var(--ln);background:var(--sf);border-radius:8px;padding:8px 14px;cursor:pointer;font-weight:500}
.btn:hover{border-color:var(--ink)}
.btn.pri{background:var(--ac);border-color:var(--ac);color:#1B211D;font-weight:600}
.btn:disabled{opacity:.6;cursor:wait}
:focus-visible{outline:3px solid var(--md);outline-offset:2px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.chip{border:1px solid var(--ln);background:var(--sf);border-radius:999px;padding:6px 14px;cursor:pointer;font-weight:500}
.chip b{margin-left:6px;font-variant-numeric:tabular-nums}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.note{font-size:.88rem;margin:0 0 12px;padding:8px 12px;border-radius:8px;background:var(--okb);color:var(--ok)}
.note.bad{background:var(--wnb);color:var(--wn)}
.tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
.tools input,.tools select{border:1px solid var(--ln);background:var(--sf);border-radius:8px;padding:7px 10px;min-width:0}
.tools input{flex:1 1 200px}
.key{color:var(--mut);font-size:.84rem;margin:0 0 10px}
.hd,.row{display:grid;grid-template-columns:2rem minmax(0,1.5fr) repeat(3,minmax(4.2rem,.5fr)) minmax(0,2fr);gap:8px 12px;align-items:center}
.hd{padding:0 14px 6px 18px;color:var(--mut);font-size:.84rem;font-weight:500}
.row{background:var(--sf);border:1px solid var(--ln);border-left:5px solid var(--st,var(--ln));border-radius:10px;padding:10px 14px;margin-bottom:8px}
.row .no{color:var(--mut);font-variant-numeric:tabular-nums}
.nm b{display:block;font-weight:600;overflow-wrap:anywhere}.nm small{color:var(--mut)}
.t{font-weight:600;font-variant-numeric:tabular-nums}
.t.ok{color:var(--ok)}.t.wn{color:var(--wn)}.t.ms{color:var(--ms);font-weight:500}.t.md{color:var(--md)}
.pill{display:inline-block;border-radius:6px;padding:1px 8px;margin:0 6px 4px 0;font-size:.85rem;font-weight:500}
.pill.ok{background:var(--okb);color:var(--ok)}.pill.wn{background:var(--wnb);color:var(--wn)}.pill.ms{background:var(--msb);color:var(--ms)}.pill.md{background:var(--mdb);color:var(--md)}
.sub{grid-column:2/-1;display:flex;align-items:center;gap:12px}
.all{color:var(--mut);font-size:.82rem;font-variant-numeric:tabular-nums;flex:0 0 auto;max-width:42%}
.strip{position:relative;height:16px;flex:1;background:var(--tl);border-radius:8px;overflow:hidden}
.strip i{position:absolute;top:0;bottom:0;background:var(--zn)}
.strip u{position:absolute;top:3px;width:10px;height:10px;margin-left:-5px;border-radius:50%;border:2px solid var(--sf);background:var(--xx)}
.strip u.ok{background:var(--ok)}.strip u.wn{background:var(--wn)}.strip u.md{background:var(--md)}
.empty{padding:28px;text-align:center;color:var(--mut)}
@media(max-width:760px){
 .hd{display:none}
 .row{grid-template-columns:repeat(3,1fr)}
 .row .no{display:none}
 .nm,.st,.sub{grid-column:1/-1}
 .t::before{content:attr(data-l);display:block;font-weight:400;font-size:.78rem;color:var(--mut)}
 .sub{flex-wrap:wrap}.all{max-width:100%}.strip{flex:1 1 100%}
}
.nm .grp{margin-top:6px}
.grp{display:flex;gap:6px;flex-wrap:wrap}
.gb{border:1px solid var(--ln);background:transparent;color:var(--mut);border-radius:6px;padding:2px 9px;font-size:.82rem;font-weight:500;cursor:pointer}
.gb:hover{border-color:var(--ink);color:var(--ink)}
.gb[aria-pressed="true"]{background:var(--gc);border-color:var(--gc);color:var(--gt)}
.tm{margin-bottom:12px;background:var(--sf);border:1px solid var(--ln);border-radius:10px;padding:10px 14px}
.tm summary{cursor:pointer;font-weight:500}
.tr{display:flex;gap:8px;align-items:center;margin-top:8px}
.tr i{width:14px;height:14px;border-radius:4px;flex:none}
.tr input{flex:1;min-width:0;border:1px solid var(--ln);background:var(--sf);border-radius:8px;padding:6px 10px}
.wrapx{overflow-x:auto;margin-bottom:12px}
.gsum{width:100%;border-collapse:collapse;background:var(--sf);border:1px solid var(--ln);font-size:.88rem}
.gsum th,.gsum td{padding:6px 10px;text-align:left;border-bottom:1px solid var(--ln);font-variant-numeric:tabular-nums;white-space:nowrap}
.gsum th{color:var(--mut);font-weight:500}
#pdfroot{position:fixed;left:-12000px;top:0}
.up2{margin-top:14px;border:1px solid var(--ln);border-radius:12px;background:var(--sf);padding:14px 16px}
.up2>b{display:block}.up2 .key{margin:2px 0 8px}
.wg{display:inline-flex;align-items:center;gap:6px;margin-top:6px;font-size:.82rem;color:var(--mut)}
.wg input{width:96px;border:1px solid var(--ln);background:var(--sf);border-radius:6px;padding:2px 8px;font-variant-numeric:tabular-nums}
.wp{margin-top:12px}
.wp table{border-collapse:collapse;font-size:.88rem;margin:8px 0}
.wp td,.wp th{padding:4px 12px 4px 0;border-bottom:1px solid var(--ln);text-align:left;font-variant-numeric:tabular-nums}
.wp .ro{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.abs{margin-bottom:12px;background:var(--sf);border:1px solid var(--ln);border-radius:10px;padding:10px 14px}
.abs summary{cursor:pointer;font-weight:500}
.ar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:6px 0;border-bottom:1px solid var(--ln)}
.ar small{color:var(--mut)}
.pg{width:794px;height:1123px;background:#fff;color:#111;padding:48px 44px;font:400 13px/1.45 "IBM Plex Sans Thai",sans-serif;position:relative}
.pg h3{margin:0 0 4px;font-size:21px}
.pg .sm{display:flex;gap:10px;margin:12px 0 14px}
.pg .sm div{flex:1;border:1px solid #cfd3cd;padding:7px 10px;border-radius:6px}
.pg .sm b{display:block;font-size:19px}
.pg table{width:100%;border-collapse:collapse}
.pg th{text-align:left;border-bottom:2px solid #111;padding:6px 6px;font-weight:600}
.pg td{border-bottom:1px solid #d9dcd7;padding:6px;vertical-align:top}
.pg .c{color:#555;font-size:11px}
.pg .ok{color:#1F7A4D}.pg .wn{color:#9A6700}.pg .ms{color:#B3261E}.pg .md{color:#2F55A4}
.pg .ft{position:absolute;left:44px;right:44px;bottom:26px;display:flex;justify-content:space-between;color:#777;font-size:11px}
</style>
</head>
<body>
<div class="wrap">
<header>
 <h1>ตรวจสอบรายสแกนหน้า</h1>
 <p>อัปโหลด PDF รายงานข้อมูลการลงเวลาจากระบบ TMC HR ระบบจะสรุปให้ว่าใครสแกนครบ สาย ขาด หรือออกกลางคัน</p>
</header>

<label class="drop" id="drop" tabindex="-1">
 <input type="file" id="file" accept="application/pdf,.pdf">
 <b>เลือกไฟล์ PDF หรือลากมาวางที่นี่</b>
 <span>ใช้ไฟล์ทุกหน้าของวันนั้น เพื่อให้นับจำนวนคนครบ</span>
</label>
<p id="msg" role="alert"></p>

<ul class="rules">
 <li><strong>เช้า</strong>สแกนก่อน 07:30 <em>หลังจากนั้นถือว่าสาย</em></li>
 <li><strong>บ่าย</strong>สแกน 12:50–13:00 <em>ก่อนหรือหลังช่วงนี้ถือว่าเลท</em></li>
 <li><strong>ออกงาน</strong>สแกนตั้งแต่ 17:30 เป็นต้นไป</li>
 <li><strong>อื่นๆ</strong>สแกนเช้าแล้วออกก่อนบ่ายหรือเย็น <em>ติดป้ายออกกลางคัน</em></li>
</ul>

<div class="up2">
 <b>ค่าแรง</b>
 <p class="key">อัปโหลด PDF จากหน้า “ประมาณการค่าแรง” ของ TMC HR (พิมพ์ด้วย Save as PDF) แอพจะอ่านค่าแรงต่อคนแล้วจำไว้ตามรหัสพนักงาน หรือจะพิมพ์ค่าแรงเองในช่องใต้ชื่อแต่ละคนก็ได้</p>
 <input type="file" id="wfile" accept="application/pdf,.pdf" aria-label="ไฟล์ประมาณการค่าแรง">
 <p id="wmsg" role="alert" style="margin:8px 0 0"></p>
 <div class="wp" id="wprev" hidden></div>
</div>

<section id="res">
 <div class="meta">
  <div><h2 id="site"></h2><p id="dt"></p></div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
   <button class="btn" id="again">เลือกไฟล์ใหม่</button>
   <button class="btn" id="xls">ส่งออก Excel</button>
   <button class="btn pri" id="pdf">บันทึกเป็น PDF</button>
  </div>
 </div>
 <div class="chips" id="chips"></div>
 <div class="chips" id="gchips"></div>
 <details class="tm" id="tm"><summary>จัดการประเภทคนงาน (เพิ่ม / เปลี่ยนชื่อ / ลบ)</summary>
  <div id="tlist"></div>
  <div class="tr"><input id="tnew" placeholder="ชื่อประเภทใหม่ เช่น ช่างปูน, แม่บ้าน" maxlength="30" aria-label="ชื่อประเภทใหม่"><button class="btn pri" id="tadd">+ เพิ่มประเภท</button></div>
  <p class="key" style="margin:8px 0 0">แก้ชื่อในช่องได้เลย การลบประเภทจะทำให้คนในประเภทนั้นกลับเป็นยังไม่ระบุ</p>
 </details>
 <div class="wrapx" id="gsum"></div>
 <details class="abs" id="abs" hidden><summary id="abss"></summary><div id="absl"></div></details>
 <p class="key">กดปุ่มกลุ่มใต้ชื่อแต่ละคนเพื่อระบุว่าเป็นคนของใคร ระบบจะจำตามรหัสพนักงานไว้ใช้ในวันถัดไป กดซ้ำเพื่อยกเลิก</p>
 <p class="key" id="gwarn" style="display:none;color:var(--wn)">เบราว์เซอร์นี้ไม่อนุญาตให้จดจำข้อมูล กลุ่มที่เลือกจะหายเมื่อปิดหน้านี้</p>
 <p class="note" id="cnt"></p>
 <div class="tools">
  <input type="search" id="q" placeholder="ค้นหาชื่อหรือรหัส" aria-label="ค้นหาชื่อหรือรหัส">
  <select id="srt" aria-label="เรียงลำดับ"><option value="t">เรียงตามเวลาที่สแกนแรก</option><option value="p">แสดงคนที่มีปัญหาก่อน</option><option value="g">เรียงตามกลุ่ม</option><option value="u">ยังไม่ระบุกลุ่มก่อน</option></select>
  <button class="btn" id="gclr">ล้างกลุ่มที่จำไว้</button>
 </div>
 <p class="key">แถบเวลา 06:00–18:30 พื้นที่เขียวคือช่วงที่ถูกต้อง จุดคือการสแกน (เขียว ปกติ, เหลือง สาย/เลท, น้ำเงิน ออกกลางคัน, เทา สแกนอื่น)</p>
 <div class="hd"><span>#</span><span>ชื่อ</span><span>เช้า</span><span>บ่าย</span><span>ออกงาน</span><span>สถานะ</span></div>
 <div id="list"></div>
</section>
</div>
<div id="pdfroot"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
const $=id=>document.getElementById(id);
const T=(h,m=0,s=0)=>h*3600+m*60+s;
const f=t=>String(Math.floor(t/3600)).padStart(2,'0')+':'+String(Math.floor(t%3600/60)).padStart(2,'0');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const MON=['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
const ST={ok:'ปกติ',wn:'สาย/เลท',ms:'ไม่ครบ',md:'ออกกลางคัน'};
const RANK={ms:0,md:1,wn:2,ok:3};
let D=null,filt='all',gfilt='all',G={},canStore=true;
const PAL=[['#F5B800','#1B211D'],['#6B4BB8','#fff'],['#0E7490','#fff'],['#B4532A','#fff'],['#4D7C0F','#fff'],['#A21CAF','#fff'],['#475569','#fff'],['#BE123C','#fff']];
let TY=[{k:'st',l:'ST/AR',i:0},{k:'el',l:'ไฟฟ้า',i:1},{k:'sn',l:'สุขาภิบาล',i:2}],GR,GS,GN;
try{const t=JSON.parse(localStorage.getItem('scan-types')||'null');if(Array.isArray(t)&&t.every(x=>x&&x.k&&x.l))TY=t}catch(e){}
function syncT(){GR=TY.map(t=>[t.k,t.l]);GS=Object.fromEntries(GR);GN=GS}
syncT();
const gcol=k=>PAL[((TY.find(t=>t.k===k)||{}).i||0)%PAL.length];
const tl=k=>(TY.find(t=>t.k===k)||{}).l||'-';
let W={},R={};
try{W=JSON.parse(localStorage.getItem('scan-wages')||'{}')||{};R=JSON.parse(localStorage.getItem('scan-roster')||'{}')||{}}catch(e){W={};R={}}
const sk=s=>String(s||'').replace(/[^A-Za-z]/g,'').toLowerCase()||'site';
const fmt=n=>Number(n).toLocaleString('en-US',{maximumFractionDigits:2});
const wsum=r=>{let s=0,m=0;r.forEach(p=>{W[p.id]?s+=W[p.id].w:m++});return fmt(s)+(m?' (ยังไม่มี '+m+' คน)':'')};
try{G=JSON.parse(localStorage.getItem('scan-groups')||'{}')||{}}catch(e){G={};canStore=false}
function saveG(){try{localStorage.setItem('scan-groups',JSON.stringify(G));localStorage.setItem('scan-types',JSON.stringify(TY));localStorage.setItem('scan-wages',JSON.stringify(W));localStorage.setItem('scan-roster',JSON.stringify(R));canStore=true}catch(e){canStore=false}$('gwarn').style.display=canStore?'none':'block'}
/* worker โหลดเป็น script ธรรมดา (window.pdfjsWorker) และไม่ตั้ง workerSrc เพื่อไม่ให้สร้าง Worker ข้ามโดเมน */

async function readLines(file){
 const pdf=await pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;
 const out=[];let N=0;
 for(let p=1;p<=pdf.numPages;p++){
  const tc=await(await pdf.getPage(p)).getTextContent();
  const it=tc.items.filter(i=>i.str.trim()).map(i=>({x:i.transform[4],y:i.transform[5],s:i.str})).sort((a,b)=>b.y-a.y||a.x-b.x);
  N+=it.length;let cur=[],y0=null;
  const flush=()=>{if(cur.length)out.push(cur.sort((a,b)=>a.x-b.x).map(i=>i.s).join(' '));cur=[]};
  it.forEach(i=>{if(y0!==null&&Math.abs(i.y-y0)>4){flush()}if(!cur.length)y0=i.y;cur.push(i)});
  flush();
 }
 if(!N)throw new Error('NOTEXT');
 return out;
}
function parse(lines){
 const re=/(\d{1,4})\s+(\d{5,10})\s+(.+?)\s+(\d{2})-(\d{2})-(\d{4})\s+(\d{2}):(\d{2})(?::(\d{2}))?/;
 const people=new Map(),seen=new Set();let site='',cnt=null,date='';
 lines.forEach(l=>{
  const s=l.match(/หน่วยงาน\s*:\s*(.+)/);if(s&&!site)site=s[1].trim();
  const c=l.replace(/\s+/g,'').match(/จำนวนผู้ลงเวลาเข้างาน(\d+)คน/);if(c)cnt=+c[1];
  const ln=l.replace(/(\d)\s*-\s*(\d)/g,'$1-$2').replace(/(\d)\s*:\s*(\d)/g,'$1:$2');const m=ln.match(re);if(!m)return;
  const k=m[2]+m[4]+m[5]+m[6]+m[7]+m[8]+(m[9]||'');
  if(seen.has(k))return;seen.add(k);
  const t=T(+m[7],+m[8],+(m[9]||0));date=date||m[4]+'-'+m[5]+'-'+m[6];
  const p=people.get(m[2])||{id:m[2],name:m[3].trim(),t:[]};p.t.push(t);people.set(m[2],p);
 });
 return{site:site||findSite(lines),cnt,date,people:[...people.values()]};
}
function analyse(p){
 const all=[...p.t].sort((a,b)=>a-b),cl=[];
 all.forEach(t=>{if(!cl.length||t-cl[cl.length-1]>180)cl.push(t)});
